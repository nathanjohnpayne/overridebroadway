rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {
    // Production files: artwork and investor/production PDFs
    // Path: productions/{userId}/{productionId}/{filename}
    // Writes mirror the client-side caps in src/lib/storage.ts: PDFs or
    // PNG/JPEG/WebP/GIF images, at most 20MB.
    match /productions/{userId}/{productionId}/{allPaths=**} {
      allow read, delete: if request.auth != null && request.auth.uid == userId;
      allow create, update: if request.auth != null
        && request.auth.uid == userId
        && request.resource.size <= 20 * 1024 * 1024
        && request.resource.contentType.matches('application/pdf|image/(png|jpeg|webp|gif)');
    }
  }
}
